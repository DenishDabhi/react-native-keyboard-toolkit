{
  "name": "react-native-keyboard-toolkit",
  "version": "1.0.1",
  "description": "Keyboard-aware scrolling, views, sticky form actions, and keyboard hooks for React Native on iOS and Android.",
  "author": "Denish Dabhi <dabhidenish57@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/DenishDabhi/react-native-keyboard-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenishDabhi/react-native-keyboard-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/DenishDabhi/react-native-keyboard-toolkit/issues"
  },
  "main": "dist/index.js",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "keywords": [
    "react-native",
    "keyboard",
    "keyboard-aware",
    "keyboard-management",
    "keyboard-avoiding",
    "scrollview",
    "textinput",
    "expo",
    "ios",
    "android",
    "typescript",
    "keyboard-dismiss",
    "keyboard-handling",
    "sticky-button",
    "sticky-footer"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests demo App.tsx --ext .ts,.tsx",
    "format:check": "prettier --check src tests demo App.tsx package.json README.md CHANGELOG.md docs",
    "start": "react-native start",
    "test": "jest --runInBand",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run validate"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.71.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  }
}
